[Unit]
Description=Stremio reverse-proxy signed session validator
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /usr/local/libexec/stremio-proxy-session.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/nginx/.stremio-session-key
RestrictAddressFamilies=AF_INET AF_UNIX

[Install]
WantedBy=multi-user.target
